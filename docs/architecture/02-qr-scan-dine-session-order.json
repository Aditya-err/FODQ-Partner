  "cards": [
    {
      "dot": "cyan",
      "title": "Physical Presence Security",
      "items": [
        "Raw QR token contains a high-entropy secret verified against table.qr_secret_hash",
        "Tokens are cryptographically rotated on demand without database schema alteration",
        "Zero dependency on restaurant Wi-Fi or LAN IP matching"
      ]
    },
    {
      "dot": "emerald",
      "title": "DineSession Lifecycle",
      "items": [
        "A verified scan attaches the customer to an existing table session or creates an active one",
        "Multiple guests at the same table share the single active DineSession securely",
        "Sessions persist across browser refreshes and cellular network handovers"
      ]
    },
    {
      "dot": "rose",
      "title": "Server-Side Pricing Authority",
      "items": [
        "Client cart totals are treated as advisory; backend recomputes every line item price",
        "Order items and selected modifiers are snapshotted in PostgreSQL at the moment of order",
        "Redis broadcasts order notifications in real time to kitchen display screens"
      ]
    }
