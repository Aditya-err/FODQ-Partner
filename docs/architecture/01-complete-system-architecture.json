  "cards": [
    {
      "dot": "cyan",
      "title": "Client & Edge Ingress",
      "items": [
        "Customer Web (Next.js) handles zero-install table ordering over mobile data or Wi-Fi",
        "Edge reverse proxy (Cloudflare / Nginx) terminates HTTPS :443 and protects backend ports",
        "Owner Flutter App and Kitchen KDS communicate with the identical backend API"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust Boundaries & Security",
      "items": [
        "Cryptographic QR secret hash validation proves physical presence at table",
        "Owner & Kitchen authenticated via JWT Bearer tokens and device session tracking",
        "Server-side authority: clients never dictate item prices, bill totals, or table states"
      ]
    },
    {
      "dot": "emerald",
      "title": "Order, Payment & Persistence",
      "items": [
        "Orders transition: PLACED → ACCEPTED → PREPARING → READY → SERVED on KDS",
        "Payment verification: Razorpay webhook HMAC signature verified before session closure",
        "PostgreSQL guarantees ACID persistence; Redis provides rate limits and realtime pub/sub"
      ]
    }
  ]
