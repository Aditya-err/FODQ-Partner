  "cards": [
    {
      "dot": "cyan",
      "title": "Strict Credential Security",
      "items": [
        "Passwords hashed using Bcrypt with salt; plain text never persisted or logged",
        "Optional 2FA/MFA via SMS/Email OTP before session token release",
        "Trusted device fingerprinting tracks authorized hardware sessions"
      ]
    },
    {
      "dot": "rose",
      "title": "Fine-Grained RBAC & Tenant Isolation",
      "items": [
        "Granular permissions: manage_tables, manage_menu, manage_orders, view_analytics",
        "Multi-tenant isolation: requests validate X-Restaurant-ID and enforce database tenant scoping",
        "Prevents BOLA (Broken Object Level Auth) and IDOR attacks completely"
      ]
    },
    {
      "dot": "emerald",
      "title": "Instant Session Revocation",
      "items": [
        "Every JWT carries a unique session_id verified against the database and Redis cache",
        "Logout all devices instantly revokes session keys across web and mobile apps",
        "Inactivity timeout forces re-authentication to protect unattended cashier screens"
      ]
    }
  ]
