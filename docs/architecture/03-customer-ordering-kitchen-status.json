  "cards": [
    {
      "dot": "cyan",
      "title": "Strict State Transitions",
      "items": [
        "Backend enforces valid transitions: PLACED → ACCEPTED → PREPARING → READY → SERVED",
        "Out-of-order mutations are rejected with 400 Bad Request to guarantee data integrity",
        "Every state change records an immutable timestamp in PostgreSQL"
      ]
    },
    {
      "dot": "orange",
      "title": "Realtime Kitchen Synchronization",
      "items": [
        "KDS receives instant order notifications over Redis pub/sub without polling delays",
        "Items are grouped by category and station (Grill, Fryer, Salad, Dessert)",
        "Audio chimes and visual color coding alert kitchen staff to ticket urgency"
      ]
    },
    {
      "dot": "emerald",
      "title": "Customer Transparency",
      "items": [
        "Customer Web displays an animated status tracker with real-time progression",
        "Eliminates anxious hand-waving and asks to floor staff regarding food status",
        "Additional orders can be appended to the same active table session seamlessly"
      ]
    }
  ]
