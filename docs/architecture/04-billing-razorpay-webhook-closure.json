  "cards": [
    {
      "dot": "cyan",
      "title": "Never Trust the Client",
      "items": [
        "Payment success is never asserted from the client browser or mobile app",
        "FastAPI only marks a bill PAID after receiving and verifying the official Razorpay webhook",
        "Missing or mismatched X-Razorpay-Signature immediately aborts the transaction"
      ]
    },
    {
      "dot": "rose",
      "title": "Idempotent Webhook Processing",
      "items": [
        "Every event_id is recorded in the webhook_events PostgreSQL table before processing",
        "Duplicate webhook deliveries from Razorpay return 200 OK without re-executing business logic",
        "Database rollback on transient failures triggers Razorpay retry safely"
      ]
    },
    {
      "dot": "emerald",
      "title": "Clean Session & Table Teardown",
      "items": [
        "When bill payment is verified, DineSession transitions from BILLED to CLOSED",
        "Table status transitions from BILLING to AVAILABLE, immediately ready for next party",
        "Audit log records full payment metadata and revenue metrics"
      ]
    }
  ]
