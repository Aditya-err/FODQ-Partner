  "cards": [
    {
      "dot": "cyan",
      "title": "Strict Persistence Division",
      "items": [
        "PostgreSQL is the permanent source of truth; data survives server recycles and redeployments",
        "Redis is treated as strictly volatile; if Redis restarts, database state remains 100% intact",
        "All customer dine tokens and rate limits expire automatically via Redis TTL"
      ]
    },
    {
      "dot": "emerald",
      "title": "Concurrency & Idempotency",
      "items": [
        "Redis Redlock distributed locking prevents double-spend and duplicate order clicks",
        "Webhook idempotency tables in PostgreSQL prevent duplicate payment captures",
        "Isolation level ensures parallel bills on split tables calculate taxes without race conditions"
      ]
    },
    {
      "dot": "orange",
      "title": "Analytics Without Contention",
      "items": [
        "Dashboard metrics execute targeted aggregation queries with indexed timestamp ranges",
        "Heavy reporting reads do not block active table ordering or cashier billing writes",
        "Audit logs maintain non-repudiable history of table rotations and staff refunds"
      ]
    }
  ]
